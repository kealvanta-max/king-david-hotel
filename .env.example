# Web preview: explicit, browser-local, fictional records only.
NEXT_PUBLIC_DEMO_MODE=true

# API + worker: do not point these at a production database until launch gates pass.
NODE_ENV=development
DATABASE_URL=postgresql://king_david_runtime:REPLACE@localhost:5432/king_david
# Optional owner connection for db:check only; never expose to the web runtime.
MIGRATION_DATABASE_URL=
REDIS_URL=redis://localhost:6379
PORT=3001
API_ORIGIN=http://localhost:3001
WEB_ORIGIN=http://localhost:3000
PUBLIC_TENANT_ID=
PUBLIC_PROPERTY_ID=
AUTH_ISSUER=https://YOUR_IDENTITY_PROVIDER.example/
AUTH_AUDIENCE=king-david-staff
AUTH_JWKS_URL=https://YOUR_IDENTITY_PROVIDER.example/.well-known/jwks.json

# All live payments default OFF. Hubtel/Flutterwave adapters fail closed.
PAYMENT_PROVIDER=disabled
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# Optional: OTLP HTTP traces. No SQL values, payment bodies or auth headers exported.
OTEL_EXPORTER_OTLP_ENDPOINT=
